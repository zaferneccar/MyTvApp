{
  "name": "mytvapp-home",
  "version": "1.0.0",
  "private": true,
  "description": "شاشة رئيسية خاصة لتلفزيون LG webOS",
  "scripts": {
    "photos": "node tools/build-photos.js",
    "preview": "npm run photos && npx --yes http-server -p 8080 -c-1 .",
    "package": "npm run photos && node tools/stage.js && ares-package build -o dist",
    "install-tv": "ares-install -d tv dist/com.mytvapp.home_2.0.0_all.ipk",
    "launch": "ares-launch -d tv com.mytvapp.home",
    "deploy": "npm run package && npm run install-tv && npm run launch",
    "running": "ares-launch -d tv --running",
    "bump": "node -e \"const f='version.json',v=require('./'+f);v.version=String(Date.now());require('fs').writeFileSync(f,JSON.stringify(v)+'\\n')\""
  },
  "devDependencies": {
    "@webos-tools/cli": "^3.1.0"
  }
}
